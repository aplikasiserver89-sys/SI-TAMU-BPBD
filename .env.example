# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Optional password for SI-TAMU BPBD Admin Dashboard.
# If left empty, the first admin visit prompts an inline one-time password setup.
ADMIN_PASSWORD=

# ADMIN_RECOVERY_KEY: Optional emergency recovery key (min. 12 chars) for resetting
# a Super Admin password via the "Lupa Kata Sandi?" screen on Portal Internal.
ADMIN_RECOVERY_KEY=

# Email notification for Forgot Password requests (Gmail / SMTP App Password)
RESET_NOTIFY_EMAIL="aplikasiserver89@gmail.com"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Supabase Client Config (untuk Vercel & koneksi langsung via @supabase/supabase-js)
# Mendukung awalan VITE_ maupun NEXT_PUBLIC_
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server Config (Opsional - hanya untuk backend Node/Express)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

